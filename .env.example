# Copiez ce fichier vers .env; ne commitez jamais les secrets.
AGNES_API_KEY=
AGNES_API_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_IMAGE_SIZE=1K
AGNES_IMAGE_RATIO=9:16
AGNES_TIMEOUT_SECONDS=180
NEWSREEL_TTS_VOICE=fr-FR-DeniseNeural
NEWSREEL_OUTPUT_DIR=output
NEWSREEL_FFMPEG=
NEWSREEL_FFPROBE=
NEWSREEL_MODAL_APP=newsreel-fasth3
NEWSREEL_MODAL_FUNCTION=render_h3_batch
